#!name=扫描全能王 · 自动签到
#!desc=一个模块全搞定：1) 打开扫描全能王 App 自动抓取 Cookie 并存入共享存储；2) 每天 10:15 自动签到抽奖；3) 策略页有「手动签到」面板，点刷新立即执行；另有「Cookie 状态」面板可随时查看 Cookie 是否完整。注意：Surge 的 JS（脚本）开关必须打开，否则抓取不会触发。
#!author=Luna（抓取/状态脚本） / MaYIHEI（签到脚本）
#!category=签到

[Script]
扫描全能王 Cookie = type=http-request,pattern=^https://api-cs\.intsig\.net/user/cs/get_user_attribute,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/Alexanderzhen/mysg/main/camscanner/camscanner_cookie.js
扫描全能王签到 = type=cron,cronexp=15 10 * * *,timeout=120,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js
扫描全能王手动签到 = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js
扫描全能王Cookie状态 = type=generic,script-path=https://raw.githubusercontent.com/Alexanderzhen/mysg/main/camscanner/camscanner_cookie_status.js

[Panel]
扫描全能王手动签到面板 = title="扫描全能王 · 手动签到",content="点右上角刷新按钮立即签到抽奖，结果看通知",style=info,script-name=扫描全能王手动签到
扫描全能王Cookie面板 = title="扫描全能王 · Cookie 状态",content="点右上角刷新按钮，查看当前抓到的 Cookie 是否完整",style=info,script-name=扫描全能王Cookie状态

[Rule]
DOMAIN-SUFFIX,intsig.net,DIRECT
DOMAIN-SUFFIX,camscanner.com,DIRECT

[MITM]
hostname = %APPEND% api-cs.intsig.net
